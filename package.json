{
  "name": "personalab-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "db:generate": "node scripts/database.mjs generate",
    "db:setup": "node scripts/database.mjs setup",
    "db:deploy": "node scripts/database.mjs deploy",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "p-limit": "^7.3.1",
    "prisma": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "swr": "^2.5.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
