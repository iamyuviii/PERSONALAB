DATABASE_URL="file:./dev.db"
# On Render free, replace the file: URL with your hosted PostgreSQL connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Required for live research. Obtain a key from your Groq account.
GROQ_API_KEY=""
# Optional; defaults to openai/gpt-oss-20b.
# GROQ_MODEL="openai/gpt-oss-20b"

# Default: lexical retrieval, no downloads or extra API keys.
EMBEDDING_PROVIDER="lexical"
# Optional: use a previously installed local model; falls back to lexical if unavailable.
# EMBEDDING_PROVIDER="local"
# LOCAL_EMBEDDING_MODEL_PATH="D:/models/"
